---
import { getDict, localizePath } from '@i18n/ui';
import type { HeroProps } from './types';

const { lang } = Astro.props as HeroProps;
const t = getDict(lang);
---

<section class="glow-bg hero-tint relative overflow-hidden pt-24 pb-16 sm:pt-28 sm:pb-20">
  <div class="grid-pattern pointer-events-none absolute inset-0 -z-10 opacity-60"></div>

  <div class="container-x">
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <div class="text-center lg:text-left">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/60 px-4 py-1.5 text-xs font-medium text-[color:var(--color-ink-muted)]"
        >
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[color:var(--color-brand-2)] opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[color:var(--color-brand-2)]"></span>
          </span>
          {t.hero.badge}
        </span>

        <h1
          class="locale-display mt-5 font-[family-name:var(--font-display)] text-4xl font-bold tracking-[-0.035em] sm:text-5xl xl:text-6xl"
        >
          {t.hero.title_line1}<span class="text-gradient inline-block">{t.hero.title_highlight}</span>{t.hero.title_line2}
        </h1>

        <p class="locale-copy mx-auto mt-5 max-w-2xl text-base text-[color:var(--color-ink-muted)] sm:text-lg lg:mx-0">
          {t.hero.subtitle}
        </p>

        <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row lg:justify-start">
          <a href={localizePath('/contact', lang)} class="btn btn-primary w-full sm:w-auto">
            {t.hero.cta_primary}
          </a>
          <a href="#works" class="btn btn-ghost w-full sm:w-auto">
            {t.hero.cta_secondary}
          </a>
        </div>

        <div class="mt-8 grid grid-cols-3 gap-2 sm:gap-3" aria-label={t.hero.badge}>
          {
            t.hero.stats.map((s) => (
              <div class="hero-stat rounded-xl px-2 py-3 text-center sm:px-3 sm:py-4 lg:text-left">
                <div class="font-[family-name:var(--font-display)] text-xl font-bold text-gradient sm:text-2xl">
                  {s.value}
                </div>
                <div class="mt-1 text-[10px] leading-tight text-[color:var(--color-ink-muted)] sm:text-xs">
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-[color:var(--color-brand)]/10 blur-3xl"></div>
        <img
          src="/images/hero-visual.svg"
          alt=""
          width="1000"
          height="800"
          class="w-full rounded-[1.75rem] border border-[color:var(--color-border)] shadow-2xl"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-stat {
    background: color-mix(in oklab, var(--color-surface) 78%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-border) 75%, transparent);
    box-shadow: 0 10px 30px -24px var(--color-ink);
    backdrop-filter: blur(10px);
  }
</style>
