---
import { getDict, htmlLang, localizePath } from '@i18n/ui';
import BaseLayout from '@layouts/base-layout';
import { serviceImages } from './constants';
import type { ServicePageProps } from './types';

const { lang, slug } = Astro.props as ServicePageProps;
const t = getDict(lang);
const service = t.serviceDetail.items[slug];
const route = `/services/${slug}`;
const title = `${service.title} | GrowHub`;
const pageUrl = new URL(localizePath(route, lang), Astro.site ?? 'https://growhub.com.hk').href;
const homeUrl = new URL(localizePath('/', lang), Astro.site ?? 'https://growhub.com.hk').href;
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.summary,
  url: pageUrl,
  inLanguage: htmlLang[lang],
  areaServed: { '@type': 'Place', name: 'Hong Kong' },
  provider: {
    '@type': 'ProfessionalService',
    '@id': 'https://growhub.com.hk/#organization',
    name: 'GrowHub Limited',
    url: 'https://growhub.com.hk/',
  },
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: homeUrl },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.services.title,
      item: `${homeUrl}#services`,
    },
    { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl },
  ],
};
---

<BaseLayout lang={lang} route={route} title={title} description={service.summary}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article>
    <header class="glow-bg hero-tint relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-24">
      <div class="grid-pattern pointer-events-none absolute inset-0 -z-10 opacity-60"></div>
      <div class="container-x">
        <a
          href={`${localizePath('/', lang)}#services`}
          class="inline-flex items-center gap-2 text-sm font-medium text-[color:var(--color-ink-muted)] transition-colors hover:text-[color:var(--color-brand)]"
        >
          <span aria-hidden="true">←</span>
          {t.serviceDetail.back}
        </a>

        <div class="mt-10 grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
          <div>
            <p class="text-sm font-semibold tracking-[0.2em] text-[color:var(--color-brand-2)]">
              {t.serviceDetail.kicker}
            </p>
            <h1
              class="locale-display mt-3 font-[family-name:var(--font-display)] text-4xl font-bold tracking-tight sm:text-5xl"
            >
              {service.title}
            </h1>
            <p class="locale-copy mt-6 max-w-2xl text-lg text-[color:var(--color-ink-muted)]">
              {service.summary}
            </p>
            <a href={localizePath('/contact', lang)} class="btn btn-primary mt-8">
              {t.serviceDetail.ctaButton}
            </a>
          </div>

          <img
            src={serviceImages[slug]}
            alt=""
            width="800"
            height="600"
            decoding="async"
            fetchpriority="high"
            class="aspect-[4/3] w-full rounded-3xl border border-[color:var(--color-border)] object-cover shadow-2xl"
          />
        </div>
      </div>
    </header>

    <section class="py-16 sm:py-24">
      <div class="container-x grid gap-8 lg:grid-cols-2">
        <div class="card p-6 sm:p-8">
          <h2 class="font-[family-name:var(--font-display)] text-2xl font-bold">
            {t.serviceDetail.deliverablesTitle}
          </h2>
          <ul class="mt-6 grid gap-3">
            {
              service.deliverables.map((item) => (
                <li class="flex items-start gap-3 text-[color:var(--color-ink-muted)]">
                  <span class="mt-1 text-[color:var(--color-brand-2)]" aria-hidden="true">●</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card p-6 sm:p-8">
          <h2 class="font-[family-name:var(--font-display)] text-2xl font-bold">
            {t.serviceDetail.suitableTitle}
          </h2>
          <ul class="mt-6 grid gap-3">
            {
              service.suitableFor.map((item) => (
                <li class="flex items-start gap-3 text-[color:var(--color-ink-muted)]">
                  <span class="mt-1 text-[color:var(--color-brand)]" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-[color:var(--color-surface-2)]/60 py-16 sm:py-24">
      <div class="container-x">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold tracking-[0.2em] text-[color:var(--color-brand-2)]">
            {t.serviceDetail.processKicker}
          </p>
          <h2 class="mt-3 font-[family-name:var(--font-display)] text-3xl font-bold sm:text-4xl">
            {t.serviceDetail.processTitle}
          </h2>
          <p class="locale-copy mt-5 text-[color:var(--color-ink-muted)]">
            {t.serviceDetail.processIntro}
          </p>
        </div>

        <ol class="mx-auto mt-10 grid max-w-4xl gap-4 md:grid-cols-3">
          {
            t.works.steps.slice(0, 3).map((step, index) => (
              <li class="card p-6">
                <span class="font-[family-name:var(--font-display)] text-sm font-bold text-[color:var(--color-brand-2)]">
                  0{index + 1}
                </span>
                <h3 class="mt-3 font-semibold">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-muted)]">
                  {step.desc}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="py-16 sm:py-24">
      <div class="container-x">
        <div class="rounded-3xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-8 text-center shadow-[var(--card-shadow)] sm:p-12">
          <h2 class="font-[family-name:var(--font-display)] text-3xl font-bold">
            {t.serviceDetail.ctaTitle}
          </h2>
          <p class="locale-copy mx-auto mt-4 max-w-2xl text-[color:var(--color-ink-muted)]">
            {t.serviceDetail.ctaText}
          </p>
          <a href={localizePath('/contact', lang)} class="btn btn-primary mt-7">
            {t.serviceDetail.ctaButton}
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
