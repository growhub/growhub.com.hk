---
import { getDict, localizePath } from '@i18n/ui';
import Logo from '@ui/logo';
import { buildFooterLinks, buildFooterSectionLinks } from './hooks';
import type { FooterProps } from './types';

const { lang } = Astro.props as FooterProps;
const t = getDict(lang);
const year = new Date().getFullYear();
const pageLinks = buildFooterLinks(lang);
const sectionLinks = buildFooterSectionLinks(lang);
---

<footer class="mt-20 border-t border-[color:var(--color-border)] bg-[color:var(--color-surface-2)]/55 sm:mt-24">
  <div class="container-x py-10 sm:py-14">
    <div
      class="mb-10 flex flex-col gap-5 rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5 shadow-[var(--card-shadow)] sm:flex-row sm:items-center sm:justify-between sm:p-7"
    >
      <div>
        <p class="text-xs font-semibold tracking-[0.18em] text-[color:var(--color-brand-2)]">
          {t.footer.contactKicker}
        </p>
        <p class="mt-2 font-[family-name:var(--font-display)] text-xl font-semibold sm:text-2xl">
          {t.footer.contactPrompt}
        </p>
      </div>
      <a
        href={localizePath('/contact', lang)}
        class="btn btn-primary w-full justify-between sm:w-auto sm:justify-center"
      >
        {t.footer.nav_contact}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
      <!-- Brand -->
      <div class="col-span-2 w-full lg:col-span-2">
        <a href={localizePath('/', lang)} class="flex items-center gap-2">
          <Logo size={32} />
          <span class="logo text-2xl">GrowHub</span>
        </a>
        <p class="mt-3 w-full text-sm leading-relaxed text-[color:var(--color-ink-muted)]">
          {t.footer.tagline}
        </p>
        <address class="mt-5 flex items-start gap-2 text-xs not-italic leading-relaxed text-[color:var(--color-ink-faint)]">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="mt-0.5 shrink-0"
          >
            <path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
          {t.company.values.address}
        </address>
      </div>

      <!-- Explore (sections) -->
      <nav class="border-t border-[color:var(--color-border)] pt-6 lg:border-0 lg:pt-0" aria-label={t.footer.explore}>
        <h2 class="text-xs font-semibold uppercase tracking-[0.15em] text-[color:var(--color-ink-faint)]">
          {t.footer.explore}
        </h2>
        <ul class="mt-4 space-y-3 text-sm">
          {
            sectionLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex min-h-6 items-center text-[color:var(--color-ink-muted)] transition-colors hover:text-[color:var(--color-brand)]"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Company (pages) -->
      <nav class="border-t border-[color:var(--color-border)] pt-6 lg:border-0 lg:pt-0" aria-label={t.footer.company}>
        <h2 class="text-xs font-semibold uppercase tracking-[0.15em] text-[color:var(--color-ink-faint)]">
          {t.footer.company}
        </h2>
        <ul class="mt-4 space-y-3 text-sm">
          {
            pageLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex min-h-6 items-center text-[color:var(--color-ink-muted)] transition-colors hover:text-[color:var(--color-brand)]"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-[color:var(--color-border)] pt-6 text-[11px] text-[color:var(--color-ink-faint)] sm:mt-12 sm:flex-row sm:items-center sm:justify-between sm:text-xs"
    >
      <p>© {year} GrowHub Limited. {t.footer.rights}</p>
      <p>Hong Kong · Software Studio</p>
    </div>
  </div>
</footer>
